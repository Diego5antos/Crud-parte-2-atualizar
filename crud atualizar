html lang="pt-BR">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>CRUD</title>

</head>
<body>
    <h1>CRUD</h1>
    <p>Inicie o menu do programa.</p>

    <script>

    function criarNo(dado) {
    return {
        dado: dado,
        proximo: null
    };
}

function criarLista() {
    return {
        inicio: null
    };
}

function lerDado(mensagem) {
    const entrada = window.prompt(mensagem);

    if (entrada === null) {
        return null;
    }

    const dado = entrada.trim();

    if (dado === "") {
        window.alert("O valor não pode ficar vazio.");
        return null;
    }

    return dado;
}

function lerPosicao(mensagem) {
    const entrada = window.prompt(
        mensagem + "\nAs posições começam em 0."
    );

    if (entrada === null) {
        return null;
    }

    const posicao = Number(entrada.trim());

    if (!Number.isInteger(posicao) || posicao < 0) {
        window.alert("Informe uma posição inteira não negativa.");
        return null;
    }

    return posicao;
}

function listarTodos(lista) {
    const elementos = [];
    let atual = lista.inicio;

    while (atual !== null) {
        elementos.push(atual.dado);
        atual = atual.proximo;
    }

    return elementos;
}

function inserir(lista, dado) {
    const novo = criarNo(dado);

    if (lista.inicio === null) {
        lista.inicio = novo;
        return true;
    }

    let atual = lista.inicio;

    while (atual.proximo !== null) {
        atual = atual.proximo;
    }

    atual.proximo = novo;
    return true;
}

function contarElementos(lista) {
    let quantidade = 0;
    let atual = lista.inicio;

    while (atual !== null) {
        quantidade++;
        atual = atual.proximo;
    }

    return quantidade;
}

function inserirNaPosicao(lista, dado, posicao) {
    if (
        typeof posicao !== "number" ||
        !Number.isInteger(posicao) ||
        posicao < 0
    ) {
        return false;
    }

    if (posicao > contarElementos(lista)) {
        return false;
    }

    const novo = criarNo(dado);

    if (posicao === 0) {
        novo.proximo = lista.inicio;
        lista.inicio = novo;
        return true;
    }

    let anterior = lista.inicio;

    for (let i = 0; i < posicao - 1; i++) {
        anterior = anterior.proximo;
    }

    novo.proximo = anterior.proximo;
    anterior.proximo = novo;

    return true;
}

function obterNo(lista, posicao){
    if (!Number.isInteger(posicao)|| posicao < 0){
        return null;
    }
    letatual = lista.inicio;
    let i = 0;
        while (atual!== null && i < posicao){
            atual = atual.proximo;
            i++;
        }
        return atual;

}

function excluirPosicao(lista,posicao){
    let no = obterNo(lista,posicao);
    if (no === null){
        return false;
    }
    if (posicao === 0){
        lista.inicio = lista.inicio.proximo;
        return true;
    }
    let anterior = obterNO(lista,posicao -1);
    anterior.proximo = no.proximo;
    return true;
}

function atualizarPosicao(lista, posicao, novoDado){
    let no = obterNo(lista, posicao);

    if(
        no === null||
        novoDado === null||
        novoDado.trim() ===""
    ) {
        return false;
    }
    no.dado = novoDado.trim();
    return true;
}

function buscar(lista, dado){
    let atual = lista.inicio;
    let posicao = 0;

    while (atual!== null){
        if (atual.dado === dado){
            return posicao;
        }
        atual = atual.proximo;
        posicao++;
    }
    return -1;
}

function formatarLista(lista) {
    const elementos = listarTodos(lista);

    if (elementos.length === 0) {
        return "A lista está vazia.";
    }

    return elementos
        .map(function (dado, posicao) {
            return "[" + posicao + "] " + dado;
        })
        .join("\n");
}

function exibirLista(lista) {
    window.alert(formatarLista(lista));
}

function menu(lista) {
    while (true) {
        const opcao = prompt(
            "LISTA LIGADA SIMPLES\n" +
            "1 - Listar todos\n" +
            "2 - Inserir no fim\n" +
            "3 - Inserir na posicao\n" +
            "4 - Excluir posicao\n" +
            "5 - Atualizar posicao\n" +
            "6 - Buscar valor\n" +
            "7 - Sair\n" +

            "Digite a opcao desejada:"
        );

        if (opcao === null || opcao.trim() === "7") {
            break;
        }

        switch (opcao.trim()) {
            case "1": {
                exibirLista(lista);
                break;
            }

            case "2": {
                let dado = lerDado ("Digite o valor:");

                if (dado !== null) {
                    inserir (lista, dado);
                alert("Valor inserido com sucesso.");
                           
                }

                break;
            }

            case "3": {
                let dado = lerDado("Digite o valor:");

                if (dado === null) {
                    break;
                }

                let posicao = lerPosicao ("Digite a posicao:");

                if (posicao === null) {
                    break;
                }

                if (inserirNaPosicao(lista, dado, posicao)) {
                    alert("Valor inserido com sucesso.");
                    
                } else {
                    alert("Posicao invalida");

                }

                break;
            }
            case"4":{
                let posicao = lerPosicao(
                    "Qual posicao deseja excluir?");
                    if (posicao === null){
                        break;
                    }
                    if (excluirPosicao(lista, posicao)){
                        alert ("Valor excluido com sucesso.");
                    } else{
                        alert ("Posicao invalida ou lista vazia.");
                    }
                    break;
            }

            case "5": {
                let posicao = lerPosicao("Qual posicao deseja atualizar?");
                if (posicao === null){
                    break;
                }
                let dado = lerDado("Digite o novo valor:");
                if (dado === null){
                    break;
                }
                if (atualizarPosicao(lista,posicao,dado)){
                    alert("Valor atualizado com sucesso.");
                
                } else{
                    alert("Nao foi possivel atualizar.");
                }
                break;
            }
            
           case "6":{
            let dado = lerDado("Qual valor deseja buscar:");
            id (dado ===null){
                break;
            }
            let posicao = buscar(lista,dado);
            if (posicao !== -1){
                alert ("Valor encontrado na posicao" + posicao);

            } else{
            alert("Valor nao encontrado.");
            }
            break;
           }

            default:
                alert("Opção inválida.");
        }
    }
}

const lista = criarLista();

const emNavegador =
    typeof window !== "undefined" &&
    typeof window.prompt === "function";

if (emNavegador) {
    menu(lista);
}


    

    </script>
    alert(" JavaScript funcionando!");


</body>
</html>

